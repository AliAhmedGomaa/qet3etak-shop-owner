{
  "name": "shop-owner",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:shop-owner": "node dist/shop-owner/server/server.mjs",
    "postbuild:vercel": "node -e \"const fs=require('fs');const p='dist/shop-owner/browser';const src=p+'/index.csr.html';const dest=p+'/index.html';if(fs.existsSync(src)){fs.copyFileSync(src,dest);console.log('Copied index.csr.html → index.html');}else{console.warn('index.csr.html missing — skip copy');}\""
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@angular/ssr": "^21.2.19",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.17.19",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
